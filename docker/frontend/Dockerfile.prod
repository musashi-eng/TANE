# ビルドステージ
FROM node:24-alpine AS builder

WORKDIR /app

# package.jsonとpackage-lock.jsonをコピー
# .npmrc は git 管理外のため、環境変数参照だけのサンプルを .npmrc として使う
COPY frontend/package*.json ./
COPY frontend/.npmrc.example ./.npmrc

# 依存パッケージをインストール
# 社内パッケージ（GitHub Packages）用のトークンは BuildKit の secret で渡す（イメージに残さない）
RUN --mount=type=secret,id=npm_token \
    NODE_AUTH_TOKEN="$(cat /run/secrets/npm_token)" npm ci

# ソースコードをコピー
COPY frontend/ ./

# 本番用ビルド
RUN npm run build -- --configuration production

# 実行ステージ
FROM nginx:alpine

# タイムゾーン設定
RUN apk add --no-cache tzdata
ENV TZ=Asia/Tokyo

# ビルド成果物をコピー
COPY --from=builder /app/dist/tane-frontend/browser /usr/share/nginx/html

# Nginx設定ファイルをコピー
COPY docker/frontend/nginx.conf /etc/nginx/nginx.conf

# ポート80を公開
EXPOSE 80

# ヘルスチェック用にwgetをインストール
RUN apk add --no-cache wget

# Nginxを起動
CMD ["nginx", "-g", "daemon off;"]
